{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Systematik der Wissenschaftszweige",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "groups"
  ],
  "properties": {
    "source": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "name",
          "areas"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[0-9]$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "areas": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "name"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[0-9]{3}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
