{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Entscheidung",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^dec-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "kind": {
      "enum": [
        "meilenstein",
        "aussage"
      ]
    },
    "target_id": {
      "type": "string",
      "pattern": "^(ms|cl)-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "outcome": {
      "enum": [
        "erreicht",
        "nicht_erreicht",
        "offen",
        "vorlaeufig_gestuetzt",
        "mehrfach_gestuetzt",
        "widerspruechlich",
        "spricht_dagegen"
      ]
    },
    "assurance": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "quellenabgleich",
          "nachrechnung",
          "neue_daten",
          "anderes_team",
          "anderes_instrument",
          "beweisreview"
        ]
      }
    },
    "catalog_version": {
      "type": "integer",
      "minimum": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "dissent": {
      "type": "string",
      "minLength": 1
    },
    "extracted_by": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_by": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ev-[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "supersedes": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^dec-[a-z0-9]+(-[a-z0-9]+)*$"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^dec-[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      ]
    },
    "status": {
      "enum": [
        "vorgeschlagen",
        "in_pruefung",
        "freigegeben"
      ]
    }
  },
  "required": [
    "id",
    "date",
    "kind",
    "target_id",
    "outcome",
    "rationale",
    "status"
  ]
}
