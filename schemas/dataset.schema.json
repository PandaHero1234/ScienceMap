{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Datensatz oder Ereignis",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "preprocessing": {
      "type": "string",
      "minLength": 1
    },
    "derived_from": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    }
  },
  "required": [
    "id",
    "title",
    "source"
  ]
}
