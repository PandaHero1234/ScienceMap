{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Forschungsziel",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^goal-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "field": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "last_work": {
      "type": "string",
      "minLength": 1
    },
    "open_question": {
      "type": "string",
      "minLength": 1
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ms-[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "criterion"
        ]
      }
    },
    "catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "milestones": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ms-[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "version",
          "date",
          "reason",
          "milestones"
        ]
      }
    },
    "area": {
      "type": "string",
      "pattern": "^[0-9]{3}$"
    },
    "topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    }
  },
  "required": [
    "id",
    "field",
    "title"
  ]
}
