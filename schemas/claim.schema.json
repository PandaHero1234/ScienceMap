{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aussage",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cl-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "milestone_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ms-[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "statement",
    "scope",
    "milestone_ids"
  ]
}
