{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Studie",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "team": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "doi": {
      "type": "string",
      "minLength": 1
    },
    "published": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "instrument": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "status": {
      "enum": [
        "aktiv",
        "korrigiert",
        "zurueckgezogen"
      ]
    },
    "status_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status_note": {
      "type": "string",
      "minLength": 1
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          }
        },
        "required": [
          "id",
          "kind",
          "url"
        ]
      }
    },
    "short_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    }
  },
  "required": [
    "id",
    "label",
    "team",
    "status",
    "versions"
  ],
  "if": {
    "properties": {
      "status": {
        "enum": [
          "korrigiert",
          "zurueckgezogen"
        ]
      }
    },
    "required": [
      "status"
    ]
  },
  "then": {
    "required": [
      "status_date",
      "status_note"
    ]
  }
}
